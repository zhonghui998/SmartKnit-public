# ─────────────────────────────────────────────────────────────────────────────
# 配置模板 —— 复制为 .env 后填入真实值
# 真实 .env 已被 .gitignore 排除，请勿提交
# ─────────────────────────────────────────────────────────────────────────────

# 生图模型服务（火山方舟 / 豆包 Seedream）
ARK_API_KEY=
ARK_IMAGE_MODEL=

# 生图服务端口
REDRAW_PORT=8800

# 业务服务端口
ENGINE_PORT=8900

# 生产交付（SMTP）
PRODUCTION_EMAIL=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# Shopify 集成（如需）
SHOPIFY_STORE=
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_WEBHOOK_SECRET=
